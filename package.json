{
  "name": "hogwarts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A tiny persistent Hogwarts: 3D browser client + authoritative kernel + MCP server where agents forge spells as code.",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --max-semi-space-size=64 --import tsx src/server/main.ts",
    "mcp:stdio": "tsx src/mcp/stdio-bridge.ts",
    "owl": "tsx src/mcp/stdio-bridge.ts",
    "bot": "tsx scripts/bot.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "find": "tsx scripts/find.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "qrcode-generator": "^2.0.4",
    "three": "^0.186.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
